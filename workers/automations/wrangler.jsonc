{
  // One Worker hosts every automation; each gets its own route in src/index.js.
  "name": "growthclub-automations",
  "main": "src/index.js",
  "account_id": "c5410597cd6c806573552d0a83bef461",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Not secret, so they live here. Secrets are set with `wrangler secret put`
  // (see README.md): GHL_PRIVATE_TOKEN, WEBINARGEEK_WEBHOOK_SECRET.
  "vars": {
    "GHL_LOCATION_ID": "v9PRZECQMMf3nH4iagQQ",
    // Timezone the readable_webinar_* fields are written in. Must match index.html.
    "WEBINAR_TIMEZONE": "Europe/London",
    // Website form notifications. NOTIFY_TO must be a verified Email Routing
    // destination; NOTIFY_FROM must be on a domain with Email Routing enabled.
    "NOTIFY_FROM": "forms@fintechcirclepro.com",
    "NOTIFY_TO": "boards@fintechcircle.com",
    // WebinarGeek webinar the landing page registers for. /webinar/upcoming and
    // /webinar/register use its next published session automatically. To pin a
    // specific session instead, add "REGISTRATION_BROADCAST_ID". Secret:
    // WEBINARGEEK_API_KEY.
    "WEBINAR_ID": "575538",
    // Apps Script web app that appends summit submissions to the
    // "Summit Form Applicants" tab. Remove to switch the sheet write off.
    "SUMMIT_SHEET_URL": "https://script.google.com/macros/s/AKfycbx7ByoZjkHSt4DUaB_ijZ_9S283nfvsbK0j-fLEckXDPFf9ZVL-38X8deSuv1TW7IkZZQ/exec"
  },

  "send_email": [
    { "name": "NOTIFY_EMAIL", "destination_address": "boards@fintechcircle.com" }
  ]
}
